# ─────────────────────────────────────────────────────────────
#  Deploy config — copy to .env  (NEVER commit .env)
#  cp .env.example .env
# ─────────────────────────────────────────────────────────────

# REQUIRED. Your deployer wallet's private key.
# Use a FRESH throwaway wallet for testnet — never your main one.
PRIVATE_KEY=

# Get free Base Sepolia ETH here:
#   https://www.alchemy.com/faucets/base-sepolia

# ── Optional roles ────────────────────────────────────────────
# If unset, the deployer address is used for all three (fine for solo testing).
# KEEPER_ADDRESS=      # the game server that submits match results
# TREASURY_ADDRESS=    # receives the 5% platform fee
# RESOLVER_ADDRESS=    # NEUTRAL party that resolves disputes (NOT the host)

# ── Optional: use real USDC instead of deploying MockUSDC ─────
# Leave unset to deploy MockUSDC (recommended for testing — free minting).
# Base Sepolia USDC — VERIFY this address yourself before using it:
# USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
# Base mainnet USDC — VERIFY before mainnet:
# USDC_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913

# ── Optional: timeout overrides (seconds) ─────────────────────
# DISPUTE_WINDOW_SECONDS=600     # 10 min  — players can dispute a result
# LOBBY_TIMEOUT_SECONDS=3600     # 1 hour  — abandoned lobby can be refunded
# MATCH_TIMEOUT_SECONDS=86400    # 24 hrs  — stuck match can be voided

# ── Optional: contract verification on Basescan ───────────────
# Free key from https://basescan.org/myapikey
# BASESCAN_API_KEY=

# ── Game server (keeper) ──────────────────────────────────────
# The keeper wallet is SEPARATE from the owner. It can ONLY call proposeResult().
# Its private key goes on the game server, never in this repo.
# KEEPER_PRIVATE_KEY=
